        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "value": "0", "text": "DOWN" }, { "type": "value", "value": "1", "text": "UP" }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "value" },
      "targets": [{ "expr": "up{job=\"flask\"}", "legendFormat": "Flask", "refId": "A" }],
      "title": "Flask scrape",
      "type": "stat"
    },
