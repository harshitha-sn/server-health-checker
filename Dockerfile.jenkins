# Jenkins controller: LTS + Docker CLI + Python + Blue Ocean + Prometheus metrics plugin.
# Build:  docker build -f Dockerfile.jenkins -t server-health-checker-jenkins:lts .
# Full stack: docker compose up -d --build
FROM jenkins/jenkins:lts-jdk17

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        docker.io \
        python3 \
        python3-pip \
        python3-venv \
        python3-pytest \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

RUN usermod -aG docker jenkins

RUN test -x /usr/bin/docker && docker --version

# Pre-install plugins (Blue Ocean UI + Prometheus scrape endpoint + Pipeline essentials).
# Requires network during `docker build`.
USER jenkins
RUN jenkins-plugin-cli --plugins \
    blueocean \
    docker-workflow \
    git \
    workflow-aggregator \
    junit \
    prometheus \
    metrics \
    pipeline-stage-view \
    credentials-binding
