# Jenkins controller: LTS + Docker CLI + Python + Blue Ocean + Prometheus metrics plugin.
FROM jenkins/jenkins:lts-jdk17

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        docker.io \
        python3 \
        python3-pip \
        python3-venv \
        python3-pytest \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

RUN usermod -aG docker jenkins

# Fail the build if the Debian docker.io client is missing (avoids silent "docker: not found" in jobs).
RUN test -x /usr/bin/docker && /usr/bin/docker --version

USER jenkins

RUN jenkins-plugin-cli --plugins \
    blueocean \
    docker-workflow \
    git \
    workflow-aggregator \
    junit \
    prometheus \
    metrics \
    pipeline-stage-view \
    credentials-binding