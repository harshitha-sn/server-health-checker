# Copy to .env and adjust (optional). Docker Compose reads these automatically.

# Grafana admin login (change in production)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe_ToSomethingStrong

# Public URL Grafana uses in links (optional)
GRAFANA_ROOT_URL=http://localhost:3000

# Linux / Docker Desktop: GID of docker.sock (PowerShell one-liner in README)
# DOCKER_SOCK_GID=999
